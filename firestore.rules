rules_version = '2';

// キレイン Firestore セキュリティルール
// 【Phase3②】現行の本番ルールを土台に、posts への「ネガ生content・投稿者UIDの混入禁止」と
//   「非公開 private サブコレクション（クライアント読取全拒否）」だけを外科的に追加した版。
//   ⚠️ Firestoreは読取をフィールド単位で絞れない（read:true はドキュメント丸ごと返す）ので、
//     "生ネガ・投稿者は非公開" は「公開 posts docに保存しない」ことで担保する。
//     生ネガは posts/{id}/private/detail に隔離し、クライアントからは一切読ませない
//     （店本人へは D1/ダッシュボードのトークン施錠経路で届ける）。
//   cache / stores は現行のまま維持（toilet.html の店リスト読取等を壊さない）。

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 投稿（消費者の清潔評価）─────────────────────────
    match /posts/{docId} {
      // 読取：レビュー表示のため公開（ただし公開docにネガ/投稿者UIDは載せない＝下のcreate検証で強制）
      allow read: if true;
      // 作成：認証ユーザーのみ＋公開docにネガ/投稿者UIDを混ぜさせない
      allow create: if request.auth != null
                    && !request.resource.data.keys().hasAny(['negative_items', 'negative_comment', 'user_uid']);
      // 更新・削除：不可（投稿は不変。運営の掃除は Admin SDK＝ルールをバイパス）
      allow update, delete: if false;

      // ── 非公開：ネガ生content・投稿者情報（店本人／運営のみ・クライアント読取は全拒否）──
      match /private/{pdoc} {
        allow read: if false;                                       // 誰にも見せない
        allow create: if request.auth != null
                      && request.resource.data.size() < 12;         // 投稿に付随して書込のみ可
        allow update, delete: if false;
      }
    }

    // ── 店舗（現行のまま維持）─────────────────────────
    match /stores/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }

    // ── キャッシュ（店舗リスト・現行のまま維持＝toilet.htmlが読む）──
    match /cache/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
